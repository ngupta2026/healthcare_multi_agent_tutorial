# ---------------------------------------------------------------------------
# Streamlit secrets — Google OAuth configuration
# ---------------------------------------------------------------------------
# SETUP INSTRUCTIONS:
#
# 1. Copy this file to .streamlit/secrets.toml (it is git-ignored).
#
# 2. Create a Google OAuth 2.0 Client ID:
#    a. Go to https://console.cloud.google.com/apis/credentials
#    b. Click "Create Credentials" → "OAuth client ID"
#    c. Application type: "Web application"
#    d. Add Authorised redirect URIs:
#         http://localhost:8501/oauth2callback        (local dev)
#         https://<your-streamlit-cloud-app>.streamlit.app/oauth2callback  (prod)
#    e. Copy the Client ID and Client Secret below.
#
# 3. Generate a random cookie_secret (any long random string):
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 4. Run the app:
#    .\src\.venv\Scripts\streamlit.exe run streamlit_cloud_app.py
# ---------------------------------------------------------------------------

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_SECRET_run: python -c 'import secrets; print(secrets.token_hex(32))'"

[auth.google]
client_id = "REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
